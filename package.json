{
  "name": "specialpokeballs",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:full": "npm run build && wrangler pages dev dist --live-reload --port 8799",
    "watch": "vite build --watch",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "d1:migrate:local": "wrangler d1 execute DB --local --file=schema.sql",
    "d1:migrate:remote": "wrangler d1 execute DB --remote --file=schema.sql",
    "seed:pokemon-master": "node scripts/seed-pokemon-master.mjs",
    "d1:seed-master:local": "npm run seed:pokemon-master && wrangler d1 execute DB --local --file=pokemon_master_seed.sql",
    "d1:seed-master:remote": "npm run seed:pokemon-master && wrangler d1 execute DB --remote --file=pokemon_master_seed.sql"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260816.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "wrangler": "^4.123.0"
  }
}
